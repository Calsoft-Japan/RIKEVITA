                    <TablixCell>
                      <CellContents>
                        <Textbox Name="HeaderInfo">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Cstr(Fields!OrderNo.Value) + Chr(177) + 
Cstr(Fields!PackingListNo.Value) + Chr(177) + 
Cstr(Fields!ConsigneeName.Value) + Chr(177) + 
Cstr(Fields!ConsigneeAddress.Value) + Chr(177) + 
Cstr(Fields!ConsigneeAddress2.Value) + Chr(177) + 
Cstr(Fields!ConsigneePostCode.Value) + Chr(177) + 
Cstr(Fields!ConsigneeCountryRegion.Value) + Chr(177) + 
Cstr(Fields!FeederVessel.Value) + Chr(177) + 
Cstr(Fields!MotherVessel.Value) + Chr(177) + 
Cstr(Fields!VIA.Value)+ Chr(177) + 
Cstr(Fields!FromValue.Value)+ Chr(177) + 
Cstr(Fields!ToValue.Value)+ Chr(177) + 
Cstr(Fields!SailingOnOrAbout.Value) + Chr(177) + 
Cstr(Fields!CerfiticateNo.Value)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <Color>Red</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
